# SchoolConnect backend environment configuration
# Copy to `.env` and fill in real values. Never commit `.env`.

# Core
FLASK_ENV=development
APP_NAME=SchoolConnect
SECRET_KEY=replace-with-a-long-random-string
API_PREFIX=/api

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/schoolconnect
TEST_DATABASE_URL=sqlite:///:memory:

# JWT
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
# Development-only; keep false outside local testing.
RETURN_RESET_TOKENS=false

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Mail
MAIL_SERVER=localhost
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@schoolconnect.local

# Rate limiting / caching
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_DEFAULT=200 per hour
CACHE_TYPE=SimpleCache
CACHE_DEFAULT_TIMEOUT=300
# CACHE_REDIS_URL=redis://localhost:6379/0

# File storage
STORAGE_BACKEND=local
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH_MB=10
ALLOWED_UPLOAD_EXTENSIONS=png,jpg,jpeg,gif,pdf,docx,xlsx

# Cloudinary (production)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Initial admin seed (required by backend/seed.py)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Logging
LOG_LEVEL=INFO
